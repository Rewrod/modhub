<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ===== Storage (see docs/ARCHITECTURE.md "Storage backends") ===== -->
    <!-- Android 8-10: legacy shared-storage access (requestLegacyExternalStorage covers 10).
         Both are ignored from Android 13 (API 33); WRITE has no effect from 11 for apps
         targeting 30+, but declaring it up to 32 is harmless and keeps one maxSdk for both. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <!-- Android 11+: "All files access" for shared paths such as /sdcard/StardewValley/Mods.
         Does NOT cover Android/data or Android/obb (use Shizuku for those).
         Requested from Settings / the game screen via ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION.
         Google Play only allows this permission for core-function apps (file managers, backup,
         antivirus...) after a policy declaration; a mod manager is borderline, so ModHub targets
         GitHub/F-Droid distribution. A Play build would drop this and rely on SAF + Shizuku. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- TODO(shizuku): Shizuku's provider/permission entries go here once the dependency is added. -->

    <!-- ModHub Launcher bridge (docs/BRIDGE.md): signature-level permission declared by the
         launcher (abc.smapi.gameloader). Granted only when both APKs share a signing key. -->
    <uses-permission android:name="abc.smapi.gameloader.permission.MODHUB_BRIDGE" />
    <!-- "Install ModHub Launcher": hands the downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Game plugins declare <queries> for their packages in their own manifests;
         they are merged in at build time (needed for package visibility on API 30+).
         The bridge provider must be visible too, or resolveContentProvider()/call() fail on 11+. -->
    <queries>
        <provider android:authorities="abc.smapi.gameloader.modhub" />
        <!-- Settings > Developer > Export game assemblies reads the game's APKs; the Play Store
             package is also declared by :game-stardew, the Galaxy Store one only here. -->
        <package android:name="com.chucklefish.stardewvalley" />
        <package android:name="com.chucklefish.stardewvalleysamsung" />
    </queries>

    <application
        android:name=".ModHubApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ModHub"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ModHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Nexus "Mod Manager Download" links: nxm://<domain>/mods/<id>/files/<fileId>?key=..&expires=..
                 MainActivity forwards these to the nav graph (see NavGraph / handleIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nxm" />
            </intent-filter>
        </activity>

        <!-- Shares the downloaded ModHub Launcher APK (cacheDir/launcher) with the package installer.
             Authority must match LauncherInstaller.AUTHORITY_SUFFIX. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
